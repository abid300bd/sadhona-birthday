<script>

/* =====================================
   SCREEN SYSTEM
===================================== */

let currentScreen = 0;

const totalScreens = 9;


function showScreen(number){

    if(number < 0){
        number = 0;
    }

    if(number >= totalScreens){
        number = totalScreens - 1;
    }

    currentScreen = number;


    const screens =
        document.querySelectorAll(".screen");


    screens.forEach(function(screen){

        screen.classList.remove("show");

    });


    const target =
        document.getElementById(
            "screen" + currentScreen
        );


    if(target){

        target.classList.add("show");

    }


    updateCounter();


    if(currentScreen === 7){

        createStars();

    }

}


/* =====================================
   NEXT BUTTON
===================================== */

function goNext(){

    if(currentScreen < totalScreens - 1){

        showScreen(currentScreen + 1);

    }

}


/* =====================================
   COUNTER
===================================== */

function updateCounter(){

    const counter =
        document.getElementById("currentNum");


    if(!counter){

        return;

    }


    counter.textContent =
        String(currentScreen).padStart(2,"0");

}


/* =====================================
   LOADING
===================================== */

function startLoading(){

    const bar =
        document.getElementById("loadingBar");


    const text =
        document.getElementById("loadingText");


    let progress = 0;


    bar.style.width = "0%";

    text.textContent =
        "0% loading";


    const timer =
        setInterval(function(){

            progress++;


            bar.style.width =
                progress + "%";


            text.textContent =
                progress + "% loading";


            if(progress >= 100){

                clearInterval(timer);


                setTimeout(function(){

                    showScreen(1);

                },700);

            }

        },30);

}


/* =====================================
   JANUARY 2027 CALENDAR
===================================== */

function makeCalendar(){

    const calendar =
        document.getElementById("calendar");


    if(!calendar){

        return;

    }


    calendar.innerHTML = "";


    const days =
        ["S","M","T","W","T","F","S"];


    days.forEach(function(day){

        const cell =
            document.createElement("div");


        cell.className = "head";

        cell.textContent = day;


        calendar.appendChild(cell);

    });


    /*
       January 1, 2027 = Friday
    */

    const firstDay = 5;


    for(let i = 0; i < firstDay; i++){

        const blank =
            document.createElement("div");


        calendar.appendChild(blank);

    }


    for(let day = 1; day <= 31; day++){

        const cell =
            document.createElement("div");


        cell.textContent = day;


        if(day === 14){

            cell.className =
                "birthday";

        }


        calendar.appendChild(cell);

    }

}


/* =====================================
   WISH CLICK
===================================== */

function wishClick(button){

    button.style.transform =
        "scale(.96)";


    setTimeout(function(){

        button.style.transform =
            "scale(1)";

    },150);

}


/* =====================================
   ENVELOPE
===================================== */

let envelopeOpened = false;


function openEnvelope(){

    if(envelopeOpened){

        return;

    }


    envelopeOpened = true;


    const envelope =
        document.getElementById("envelope");


    const hint =
        document.getElementById("tapHint");


    envelope.classList.add("open");


    /*
       Tap text changes after clicking
    */

    hint.innerHTML = `
        <span>
            Opening Your Letter...
        </span>

        <small>
            ❤️
        </small>
    `;


    setTimeout(function(){

        showScreen(5);

    },1200);

}


/* =====================================
   CREATE STARS
===================================== */

function createStars(){

    const universe =
        document.getElementById("universe");


    if(!universe){

        return;

    }


    universe
        .querySelectorAll(".star")
        .forEach(function(star){

            star.remove();

        });


    for(let i = 0; i < 55; i++){

        const star =
            document.createElement("span");


        star.className =
            "star";


        star.style.left =
            Math.random() * 96 + "%";


        star.style.top =
            Math.random() * 96 + "%";


        star.style.animationDelay =
            Math.random() * 2 + "s";


        universe.appendChild(star);

    }

}


/* =====================================
   FALLING PETALS
===================================== */

function createPetals(){

    const app =
        document.querySelector(".app");


    if(!app){

        return;

    }


    for(let i = 0; i < 25; i++){

        const petal =
            document.createElement("span");


        petal.className =
            "petal";


        petal.style.left =
            Math.random() * 100 + "%";


        petal.style.animationDuration =
            (6 + Math.random() * 7) + "s";


        petal.style.animationDelay =
            (-Math.random() * 8) + "s";


        app.appendChild(petal);

    }

}


/* =====================================
   RESTART
===================================== */

function restart(){

    envelopeOpened = false;


    const envelope =
        document.getElementById("envelope");


    envelope.classList.remove("open");


    const hint =
        document.getElementById("tapHint");


    hint.innerHTML = `
        <span>
            Tap Here To Open
        </span>

        <small>
            ♡
        </small>
    `;


    showScreen(0);


    startLoading();

}


/* =====================================
   START
===================================== */

makeCalendar();

createPetals();

updateCounter();

startLoading();

</script>

