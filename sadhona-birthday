<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Happy Birthday Sadhona ❤️</title>

<style>
*{
    box-sizing:border-box;
    margin:0;
    padding:0;
}

html,body{
    width:100%;
    height:100%;
    overflow:hidden;
}

body{
    font-family:Arial,sans-serif;
    background:#17030d;
}

.app{
    width:100%;
    max-width:720px;
    height:100vh;
    height:100dvh;
    margin:auto;
    position:relative;
    overflow:hidden;
    background:
        radial-gradient(circle at 20% 10%,#ffffff 0%,transparent 25%),
        linear-gradient(180deg,#fffafd,#f9dce8 60%,#f3c5d7);
}

/* TOP BAR */

.top{
    position:absolute;
    top:15px;
    left:50%;
    transform:translateX(-50%);
    width:85%;
    max-width:450px;
    height:42px;
    background:rgba(255,255,255,.75);
    border-radius:30px;
    display:flex;
    align-items:center;
    justify-content:space-around;
    z-index:100;
    color:#9b3b61;
    font-size:12px;
    box-shadow:0 5px 20px rgba(100,0,40,.12);
}

.top .activeNum{
    width:27px;
    height:27px;
    background:#a90045;
    color:white;
    border-radius:50%;
    display:flex;
    justify-content:center;
    align-items:center;
}

/* SCREEN */

.screen{
    position:absolute;
    inset:0;
    display:none;
    flex-direction:column;
    align-items:center;
    justify-content:center;
    text-align:center;
    padding:80px 25px 35px;
}

.screen.show{
    display:flex;
    animation:appear .7s ease;
}

@keyframes appear{
    from{
        opacity:0;
        transform:translateY(25px);
    }

    to{
        opacity:1;
        transform:translateY(0);
    }
}

h1,h2{
    font-family:Georgia,serif;
    color:#4b092b;
}

h1{
    font-size:clamp(28px,7vw,48px);
    line-height:1.2;
}

h2{
    font-size:clamp(27px,7vw,42px);
    line-height:1.2;
    margin:12px 0;
}

h3{
    color:#941343;
    margin:10px 0 20px;
}

p{
    color:#654254;
    line-height:1.7;
    margin:7px 0;
}

/* BUTTON */

.nextBtn{
    margin-top:25px;
    border:0;
    background:linear-gradient(135deg,#b7004d,#810036);
    color:white;
    padding:14px 27px;
    border-radius:50px;
    font-size:15px;
    font-weight:bold;
    cursor:pointer;
    box-shadow:0 10px 25px rgba(130,0,55,.25);
}

.nextBtn:active{
    transform:scale(.95);
}

/* LOADING */

.heart{
    width:90px;
    height:90px;
    background:white;
    border-radius:50%;
    display:flex;
    align-items:center;
    justify-content:center;
    font-size:48px;
    color:#b00048;
    box-shadow:0 10px 35px rgba(176,0,72,.25);
    animation:pulse 1.3s infinite;
}

@keyframes pulse{
    50%{
        transform:scale(1.1);
    }
}

.loadingBox{
    width:85%;
    max-width:400px;
    height:7px;
    background:#e2a8bc;
    border-radius:20px;
    overflow:hidden;
    margin-top:30px;
}

#loadingBar{
    width:0%;
    height:100%;
    background:#a90045;
    transition:width .05s linear;
}

#loadingText{
    margin-top:9px;
    color:#8c3155;
    font-size:13px;
}

/* INTRO */

.flower{
    font-size:65px;
    animation:float 2.5s ease-in-out infinite;
}

@keyframes float{
    50%{
        transform:translateY(-12px);
    }
}

.name{
    color:#a80045;
}

/* CALENDAR */

.calendarCard{
    width:min(370px,95%);
    padding:22px;
    border-radius:20px;
    background:#fffdf9;
    box-shadow:0 20px 50px rgba(80,0,30,.15);
}

.date{
    color:#a90045;
    font-size:20px;
    font-weight:bold;
    margin:10px;
}

.calendarTitle{
    color:#941343;
    font-weight:bold;
    letter-spacing:2px;
    margin-bottom:10px;
}

.calendar{
    display:grid;
    grid-template-columns:repeat(7,1fr);
    gap:5px;
}

.calendar div{
    height:29px;
    display:flex;
    justify-content:center;
    align-items:center;
    font-size:12px;
}

.calendar .head{
    color:#a33c61;
    font-weight:bold;
}

.calendar .birthday{
    background:#a90045;
    color:white;
    border-radius:50%;
    width:29px;
    height:29px;
    margin:auto;
}

/* WISHES */

.wishIcon{
    font-size:60px;
}

.wishes{
    width:min(520px,100%);
    display:flex;
    flex-direction:column;
    gap:10px;
    margin-top:15px;
}

.wish{
    border:1px solid #efd5df;
    background:#fffafd;
    border-radius:13px;
    padding:14px;
    text-align:left;
    color:#593546;
    cursor:pointer;
    font-size:14px;
}

/* ENVELOPE */

.envelope{
    width:270px;
    height:170px;
    background:#850039;
    position:relative;
    margin-top:30px;
    border-radius:7px;
    cursor:pointer;
    box-shadow:0 20px 40px rgba(70,0,30,.25);
    overflow:hidden;

    animation:envelopeFloat 2s ease-in-out infinite;
}

@keyframes envelopeFloat{

    0%,100%{
        transform:translateY(0);
    }

    50%{
        transform:translateY(-6px);
    }
}

.flap{
    position:absolute;
    top:0;
    left:0;
    width:0;
    height:0;

    border-left:135px solid transparent;
    border-right:135px solid transparent;
    border-top:95px solid #c32365;

    transform-origin:top;
    transition:.7s;
    z-index:5;
}

.paper{
    position:absolute;

    width:210px;
    height:135px;

    left:30px;
    top:18px;

    background:#fffdf8;
    border-radius:5px;

    display:flex;
    justify-content:center;
    align-items:center;

    font-size:35px;

    transition:.8s;

    z-index:3;
}

.seal{
    position:absolute;

    z-index:10;

    left:50%;
    top:58%;

    transform:translate(-50%,-50%);

    width:45px;
    height:45px;

    border-radius:50%;

    background:#ffd8e6;
    color:#99003d;

    display:flex;
    justify-content:center;
    align-items:center;
}

.envelope.open .flap{
    transform:rotateX(180deg);
}

.envelope.open .paper{
    transform:translateY(-100px);
}

.envelope.open{
    animation:none;
}

/* TAP HERE TEXT */

.tapHint{
    margin-top:20px;

    display:flex;
    flex-direction:column;
    align-items:center;

    color:#8f1646;

    font-family:Georgia,serif;

    font-size:19px;
    font-weight:bold;

    cursor:pointer;

    animation:tapMove 1.2s ease-in-out infinite;
}

.tapHint span{
    text-shadow:0 2px 5px rgba(120,0,50,.15);
}

.tapHint small{
    display:block;

    margin-top:3px;

    color:#c00050;

    font-size:24px;

    line-height:20px;

    animation:heartBeat 1s ease-in-out infinite;
}

@keyframes tapMove{

    0%,100%{
        transform:translateY(0);
        opacity:.7;
    }

    50%{
        transform:translateY(-6px);
        opacity:1;
    }
}

@keyframes heartBeat{

    0%,100%{
        transform:scale(1);
    }

    50%{
        transform:scale(1.35);
    }
}

/* LETTER */

.letter{
    width:min(530px,95%);
